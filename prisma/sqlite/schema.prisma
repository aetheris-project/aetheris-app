// Aetheris core data model.
// PostgreSQL via Prisma ORM. Run `npx prisma migrate dev` to apply.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null when authentication is delegated (Clerk, SSO)
  authProvider String   @default("nextauth") // nextauth | clerk | saml
  role         String @default("client")
  organization Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([organizationId])
}


model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  status       String @default("active")
  users        User[]
  whitelabel   WhitelabelConfig?
  hypervisors  HypervisorCredential[]
  nodes        Node[]
  servers      Server[]
  plans        Plan[]
  invoices     Invoice[]
  subscriptions Subscription[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


// ---------------------------------------------------------------------------
// Dynamic whitelabeling (admin-configurable without rebuilds)
// ---------------------------------------------------------------------------

model WhitelabelConfig {
  id              String   @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String   @unique
  brand           String // { name, tagline, logoUrl, logoDarkUrl, domain }
  theme           String // { accent: emerald|indigo|amber, radius, fontFamily }
  navigation      String // [{ label, href, cta }]
  emailTemplates  String // keyed by event: invoice.created, server.suspended, ...
  modules         String // { billing, vncConsole, pterodactyl, proxmox, virtfusion, registrars }
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Hypervisor orchestration
// ---------------------------------------------------------------------------

model HypervisorCredential {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  kind           String // pterodactyl | proxmox | virtfusion
  name           String
  // Encrypted at rest (AES-256-GCM) before persistence; never logged.
  configEncrypted String
  enabled        Boolean       @default(true)
  nodes          Node[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, name])
  @@index([kind])
}


model Node {
  id                String   @id @default(cuid())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  hypervisor        HypervisorCredential @relation(fields: [hypervisorId], references: [id])
  hypervisorId      String
  externalId        String // upstream node identifier on the hypervisor
  name              String
  location          String
  status            String @default("online")
  capacity          String // { cores, memoryMb, diskMb }
  servers           Server[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([hypervisorId, externalId])
  @@index([organizationId])
}


model Server {
  id                String        @id @default(cuid())
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  node              Node          @relation(fields: [nodeId], references: [id])
  nodeId            String
  externalId        String // upstream server identifier
  clientUserId      String
  name              String
  state             String @default("installing")
  resources         String // { vcpu, memoryMb, diskMb, swapMb, io, cpuLimitPct }
  environment       String // egg/template variables
  ipv4              String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([nodeId, externalId])
  @@index([organizationId, state])
}


// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Plan {
  id               String   @id @default(cuid())
  organization     Organization? @relation(fields: [organizationId], references: [id])
  organizationId   String?
  name             String
  monthlyPriceCents Int
  setupFeeCents    Int      @default(0)
  currency         String   @default("USD")
  limits           String // resource limits granted to subscribers
  active           Boolean  @default(true)
  subscriptions    Subscription[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscription {
  id               String   @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String
  plan             Plan     @relation(fields: [planId], references: [id])
  planId           String
  status           String @default("active")
  periodStart      DateTime
  periodEnd        DateTime
  provider         String? // stripe | paypal | mollie
  providerSubId    String?
  invoices         Invoice[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, status])
}


model Invoice {
  id               String      @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId   String?
  number           String      @unique
  status           String @default("pending")
  totalCents       Int
  currency         String      @default("USD")
  dueDate          DateTime
  lines            InvoiceLine[]
  payments         Payment[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([organizationId, status])
}


model InvoiceLine {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  description String
  quantity  Int     @default(1)
  unitCents Int
  totalCents Int
  metadata  String?
}

model Payment {
  id              String   @id @default(cuid())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId       String
  provider        String // stripe | paypal | mollie
  providerPaymentId String?
  status          String @default("pending")
  amountCents     Int
  currency        String   @default("USD")
  method          String? // { brand, last4, expiry }
  failureReason   String?
  createdAt       DateTime @default(now())

  @@index([invoiceId, status])
}


// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String // server.provisioned, invoice.paid, node.drained, ...
  entityType     String?
  entityId       String?
  metadata       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
}