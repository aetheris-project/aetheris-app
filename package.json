{
  "name": "aetheris-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aetheris core billing system, admin control plane, hypervisor drivers and client portal.",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate && prisma generate --schema prisma/sqlite/schema.prisma",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pretypecheck": "prisma generate --schema prisma/sqlite/schema.prisma",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "prisma generate --schema prisma/sqlite/schema.prisma",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:sqlite": "prisma migrate deploy --schema prisma/sqlite/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/lib/__tests__/crypto.test.ts src/lib/__tests__/queue.test.ts",
    "worker": "tsx src/workers/index.ts",
    "deploy": "bash bin/install.sh --yes"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bullmq": "5.12.2",
    "clsx": "2.1.1",
    "ioredis": "5.4.1",
    "lucide-react": "0.454.0",
    "next": "14.2.35",
    "next-auth": "4.24.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
