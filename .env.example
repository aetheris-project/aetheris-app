# Aetheris app - environment reference.
# Copy to .env and fill in real values. All variables are validated at boot by
# src/lib/config/env.ts (zod). See README.md for the full reference table.

# --- Core ---
NODE_ENV=development
AETHERIS_APP_URL=http://localhost:3000
AETHERIS_SECRET=change-me-to-a-64-byte-random-string

# --- Data ---
# Two engines are supported:
#   postgres (default): DATABASE_URL=postgresql://aetheris:aetheris@127.0.0.1:5432/aetheris
#   sqlite (recommended for tests): set AETHERIS_DB_MODE=sqlite and point
#   DATABASE_URL at a local file, e.g. DATABASE_URL=file:./dev.db
DATABASE_URL=postgresql://aetheris:aetheris@127.0.0.1:5432/aetheris
# AETHERIS_DB_MODE=sqlite
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MOLLIE_API_KEY=

# --- Pterodactyl (Application API) ---
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_APP_API_KEY=
PTERODACTYL_CLIENT_API_KEY=

# --- Proxmox VE ---
PROXMOX_URL=https://pve.example.com:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=

# --- VirtFusion ---
VIRTFUSION_URL=https://vf.example.com
VIRTFUSION_API_KEY=

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- Registrars ---
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=

# --- Workers ---
BULLMQ_CONCURRENCY=8
